# Relative index pages (navigation links in generated HTML)

# lychee resolves these to file:// URIs, so match on the path

file://.*titles-generated/(main|pr-.*|release-.*|rhdh-.*|1\.\d+\.x)/index\.html$
file://.*titles-generated/pulls\.html$
file://.*titles-generated/index\.html$

# External sites that block automated requests
^https://fonts\.google\.com/icons

# Release notes site is behind Red Hat VPN, unreachable from GitHub Actions
^https://red-hat-developers-documentation\.pages\.redhat\.com/red-hat-developer-hub-release-notes

# Site exists but refuses the crawler
^https://scorecard.dev

# operatorhub.io returns 503 errors intermittently
^https://operatorhub\.io/how-to-install-an-operator

# backstage/backstage example files return 503 during GitHub rate limiting
^https://github\.com/backstage/backstage/blob/master/packages/catalog-model/examples/

# GitHub repositories return 503 during rate limiting - temporarily exclude
# Remove once GitHub rate limits stabilize or RHDH 2.1 docs are published
^https://github\.com/redhat-developer/rhdh/blob/main/docs/dynamic-plugins/
^https://github\.com/redhat-developer/rhdh-cli/blob/main/
^https://github\.com/redhat-developer/rhdh-plugins/blob/main/
^https://github\.com/redhat-developer/rhdh-local/blob/main/
^https://github\.com/redhat-developer/rhdh-dynamic-plugin-factory/blob/main/
^https://github\.com/backstage/charts/blob/
^https://github\.com/lightspeed-core/

# MCP specification site blocks automated crawlers
^https://spec\.modelcontextprotocol\.io/

# vllm.ai rate-limits automated requests (429)
^https://docs\.vllm\.ai

# RHDH 2.1 source-repo branches (release-{product-version}) do not exist yet.
# These links resolve once the rhdh, rhdh-operator, rhdh-chart, and rhdh-local
# repositories cut their release-2.1 branches at GA. Remove this entry then.
^https://(github|raw\.githubusercontent)\.com/redhat-developer/rhdh(-operator|-chart|-local)?/.*release-2\.1/
